# =============================================================================
# MediBook Environment Variables Template
# Copy this file to .env and configure your secrets locally.
# DO NOT COMMIT .env TO VERSION CONTROL.
# =============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=http://localhost:5173

# Database Configuration (Neon PostgreSQL Cloud / Local PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
POSTGRES_DB=neondb
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mail Configuration (Optional for production email dispatch)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Docker / Local Dev Services (Optional)
PGADMIN_EMAIL=admin@medibook.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
