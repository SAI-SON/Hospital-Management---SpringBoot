# =============================================================================
# MediBook - Git Ignore Configuration
# =============================================================================

# 1. Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.production
.neon
*.pem
*.key
*.p12

# Explicitly allow the safe template
!.env.example

# 2. Node & Frontend Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Java, Maven & Backend Builds
target/
backend/target/
*.class
*.jar
*.war
*.ear
backend/.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml

# 4. IDEs & Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# 5. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. Runtime Logs & Dumps
*.log
logs/
backend/logs/
*.pid
*.seed
*.pid.lock

# 7. Temporary / Scratch Scripts
test_neon_services.mjs
scratch/
.system_generated/
